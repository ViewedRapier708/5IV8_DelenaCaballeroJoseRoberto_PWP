<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos del circulo infernal</title>
</head>
<body>
    <main class="container">
        <h1>Lista de cursos disponibles</h1>
 
            <table class="table" border="1">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre del curso</th>
                        <th>Descripcion</th>
                        <th>Docente</th>
                    </tr>
                </thead>
               <%
                if(Array.isArray(cursos) && cursos.length > 0) {

               %>
               <tbody>
                <tr>
                    <%
                    cursos.forEach(function(curso )=> {
                        <td>curso.id</td>
                        <td>curso.nombre || 'nanai '</td>
                        <td>curso.descripcion  || 'nanai'</td>
                        <td>curso.docente || 'nanai'</td>
                     
                    %>
                </tr>
                    <%
                    });
                    %>
               </tbody>
            </table>
            <%}else{
                <div>
                    No hay cursos disponibles en este momento existe un error al cargarlos
                </div>
                <p><a href="../views/bienvenida.ejs">Volver a Bienvenida</a></p>
            <%}
                %>
       
    </main>
</body>
</html>