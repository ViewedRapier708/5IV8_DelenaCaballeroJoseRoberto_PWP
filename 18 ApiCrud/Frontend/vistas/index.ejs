<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagina de productos</title>
</head>
<body>
   <nav>
    <h1> <a href="<%= tableName === '/products' ?  'products': '/'%>">Lista de Productos <%= tableName ==='/product' ? 'Producto': 'Inicio' %></a></h1>
   </nav>

   <div class="query-container">                                             
    <form class="create-container">
        <h2>Crear nuevo producto</h2>
        <input type="text" id="newItemCategory" name="categorid" placeholder="ID" display="<%= tableName === '/categories' ? 'none' : '' %>" required>
        <input type="text" id="newItemName" name="name" placeholder="Nombre del producto" required>
        <input type="number" id="newItemPrice" name="price" placeholder="Precio del producto" required>
        <input type="text" id="newItemStock" name="stock" placeholder="Cantidad en el inventario" required>
        <button type="submit" id="createButton" onclick="createNewItem(event)">Crear Producto</button>

    </form>
   </div>


</body>
</html>